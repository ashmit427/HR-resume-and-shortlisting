# ─────────────────────────────────────────────────────────────
# TalentLens AI — API Key Configuration
# Only ONE key is needed. Set whichever you have.
# ─────────────────────────────────────────────────────────────

# OPTION 1: Anthropic Claude (recommended — best quality)
# Get free key at: https://console.anthropic.com
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# OPTION 2: HuggingFace (free, no credit card needed)
# Get free key at: https://huggingface.co/settings/tokens
HUGGINGFACE_API_KEY=your_huggingface_api_key_here

# ─────────────────────────────────────────────────────────────
# Optional: LangSmith tracing (bonus marks)
# Get key at: https://smith.langchain.com
# ─────────────────────────────────────────────────────────────
# LANGSMITH_API_KEY=your_langsmith_key_here
# LANGSMITH_PROJECT=talentlens-hr-agent
